# ACM CodeNite 2027 Environment Configuration

# Backend Server Port
PORT=5000

# Administrator Credentials
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters

# Comma-separated frontend origins when the frontend is hosted separately
CORS_ORIGINS=

# Google Apps Script Web App Deployment URL (Live Google Sheets & Drive PDF Automation)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxtthUGjAj4CPig_zQ0jRSmtbEXNjk8wUjshPWz0RSSEQuOXfrfxkmjH5p_OsQi7PwW/exec
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxtthUGjAj4CPig_zQ0jRSmtbEXNjk8wUjshPWz0RSSEQuOXfrfxkmjH5p_OsQi7PwW/exec
